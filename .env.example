# Virtuozo (open source) is browser-only: your Meta token, ad account and
# PowerBrix key are entered in the app UI (Settings) and stored in your browser.
# You normally DON'T need a .env file at all.
#
# These optional variables only override defaults for the whole install:

# Meta Graph API version used by the server routes.
# META_API_VERSION=v23.0

# PowerBrix router (OpenAI-compatible gateway) Studio generation runs through,
# and the model slugs it uses. Override only if you self-host the gateway.
# POWERBRIX_BASE_URL=https://api.powerbrix.ai
# POWERBRIX_IMAGE_MODEL=openai/gpt-image-2
# POWERBRIX_TEXT_MODEL=openai/gpt-5
